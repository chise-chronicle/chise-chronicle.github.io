---
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
import coverImage from "../assets/images/pixeltrue-space-discovery.svg";
---

<MainLayout activePage="contact" pageTitle={siteConfig.title + " | Contact"}>
  <div class="page-content">
    <h1 class="sigmar-ff text-balance">{siteConfig.contactInfo?.title}</h1>
    <Image
      width={400}
      height={300}
      loading="eager"
      layout="fixed"
      class="rounded-4xl mb-8 mx-auto grayscale-75 saturate-200"
      src={coverImage}
      alt="Illustrated contact card"
    />
    <div class="flex flex-col">
      <p class="font-light text-left text-balance">
        {siteConfig.contactInfo?.text}
      </p>
      {
        siteConfig.contactInfo?.email?.href &&
          siteConfig.contactInfo?.email?.email && (
            <p class="font-light text-left">
              {siteConfig.contactInfo?.email?.text}<br />
              <a
                href={siteConfig.contactInfo?.email?.href}
                class="font-light text-left"
              >
                {siteConfig.contactInfo?.email?.email}
              </a>
            </p>
          )
      }
      {
        siteConfig.contactInfo?.socialProfiles &&
          siteConfig.contactInfo.socialProfiles.length > 0 && (
            <p class="font-bold text-left flex flex-col sm:flex-row">
              Social Profiles:
              {
                siteConfig.contactInfo.socialProfiles.map((profile) => (
                  <a href={profile.href} class="font-light text-left ml-4">
                    {profile.text}
                  </a>
                ))
              }
            </p>
          )
      }
    </div>
  </div>
</MainLayout>
